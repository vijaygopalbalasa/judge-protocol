PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
# Preferred: low-cost OpenRouter AI with structured output support.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional alternative if OpenRouter is not configured.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
JUDGE_PAY_FEE_BPS=500
JUDGE_PAY_DEADLINE_HOURS=72
JUDGE_PAY_DATA_DIR=./.data
# Optional: used by the real sandbox CLI runner. Never use a real PayPal password.
# JUDGE_PAY_WORKER_EMAIL=your-us-personal-sandbox-worker-email
# Optional: required only to reconcile a payout that stopped for manual review.
# JUDGE_PAY_OPERATOR_KEY=use-a-long-random-value
# Real money requires both of these deliberate settings. Leave them off for the hackathon.
# PAYPAL_ENV=live
# JUDGE_PAY_ALLOW_LIVE=yes
