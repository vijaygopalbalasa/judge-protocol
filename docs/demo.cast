{"version":3,"term":{"cols":80,"rows":24,"type":"xterm-256color"},"timestamp":1786108040,"command":"./demo-run.sh","env":{"SHELL":"/bin/zsh"}}
[0.038, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.001, "o", "\u001b[1;36m# Judge Protocol: deterministic evaluator for ERC-8183 agent escrow\u001b[0m\r\n"]
[1.208, "o", "\u001b[1;36m# Live on Arc testnet. Judging a real job on Circle's canonical contract.\u001b[0m\r\n"]
[1.208, "o", "\r\n"]
[0.000, "o", "\u001b[1;36m## Step 1: post a job, provider delivers, judge settles the escrow\u001b[0m\r\n"]
[1.211, "o", "\u001b[1;32m$ node --env-file=.env src/e2e.js\u001b[0m\r\n"]
[1.511, "o", "\r\n=== E2E (PASS path): provider-authored deliverable ===\r\n"]
[0.000, "o", "1) client createJob (criteria only, evaluator = JudgeEvaluator)\r\n"]
[1.756, "o", "   jobId = 171507 | tx 0xaab42a2901a37c5869aa0a281f74e715622b0b13f1191b42b2a929d075802212\r\n2) SIGNER registers criteria hash on-chain (while Open, before submission)\r\n"]
[1.543, "o", "   criteriaHash 0x9b2b732563a22ef61ba2a48dd6f9eae1a59724926c1d7a3e21bfda21dcfff2d6 committed\r\n3) provider setBudget\r\n"]
[1.636, "o", "4) client approve + fund\r\n"]
[3.118, "o", "5) PROVIDER submit: deliverable hash + deliverable URI in optParams\r\n"]
[2.139, "o", "   provider 2.976747 USDC | client 2.895708 USDC, waiting for judge…\r\n"]
[2.855, "o", "   FINAL: Completed | provider 2.976747→3.976747 | client 2.895708→2.895708\r\n\r\nE2E RESULT: COMPLETED as expected ✓  jobId=171507\r\n\r\n"]
[0.018, "o", "\r\n"]
[1.006, "o", "\u001b[1;36m## Step 2: now recompute that verdict from PUBLIC inputs only\u001b[0m\r\n"]
[1.216, "o", "\u001b[1;36m##         (anyone can do this; no access to the judge needed)\u001b[0m\r\n"]
[1.233, "o", "\u001b[1;32m$ node --env-file=.env src/verify.js 171507 --evidence evidence/job-171507-7e5b8f88.json\u001b[0m\r\n"]
[1.251, "o", "\r\nVerifying job 171507 on https://rpc.testnet.arc.io\r\n"]
[0.001, "o", "  ACP=0x0747EEf0706327138c69792bF28Cd525089e4583\r\n  Judge=0x6EFF7d4BB514d341AbEd90bF4c667d0A980173AD\r\n\r\n"]
[0.551, "o", "Job status: Completed · on-chain verdict: PASS score=100 threshold=100\r\n\r\n"]
[0.001, "o", "  \u001b[32m✓\u001b[0m criteriaHash recomputed from description matches signed verdict  \r\n      recomputed=0x9b2b732563a22ef61ba2a48dd6f9eae1a59724926c1d7a3e21bfda21dcfff2d6\r\n      onchain   =0x9b2b732563a22ef61ba2a48dd6f9eae1a59724926c1d7a3e21bfda21dcfff2d6\r\n"]
[0.002, "o", "  \u001b[32m✓\u001b[0m deliverable content (evidence.deliverableURI) hashes to the committed bytes32  \r\n      recomputed=0x4c5568398a9872a61017f57d995c215d9f2d1a2554c8a8834b5ab00b0d136d3a\r\n      committed =0x4c5568398a9872a61017f57d995c215d9f2d1a2554c8a8834b5ab00b0d136d3a\r\n"]
[0.000, "o", "  \u001b[32m✓\u001b[0m score recomputed = on-chain score  (recomputed 100, onchain 100)\r\n"]
[0.000, "o", "  \u001b[32m✓\u001b[0m threshold recomputed = on-chain threshold  (recomputed 100, onchain 100)\r\n"]
[0.000, "o", "  \u001b[32m✓\u001b[0m pass/reject decision matches  (recomputed true, onchain true)\r\n"]
[0.001, "o", "  \u001b[32m✓\u001b[0m evidenceHash recomputed from inputs = on-chain evidenceHash  \r\n      recomputed=0x7e5b8f886a8fee32e9a041c89993ec625c649be2942a2b1a058d32db5a55300d\r\n      onchain   =0x7e5b8f886a8fee32e9a041c89993ec625c649be2942a2b1a058d32db5a55300d\r\n"]
[0.000, "o", "\r\n\u001b[32mVERDICT VERIFIED: recomputed independently from public inputs.\u001b[0m\r\n\r\n"]
[0.008, "o", "\r\n\u001b[1;36m# The judge cannot lie without being caught. That's the whole point.\u001b[0m\r\n"]
[3.211, "x", "0"]
