# Secrets: never commit
.env
.env.*
!.env.example
*.key
.wallets.tmp

# Build artifacts / caches (regenerable)
contracts/out/
contracts/cache/
node_modules/
__pycache__/
*.pyc
judge-service/judge-service.log
judge-service/state/
# Raw per-job output of judge-service/src/measure-acp.js; the summary it also writes (acp-measurement.json) is
# what the verifier shows and stays committed.
judge-service/acp-measurement.csv

# NOTE: contracts/broadcast/ (deploy receipts) and judge-service/evidence/
# (verdict evidence) are intentionally COMMITTED; they are public on-chain
# data and serve as the audit trail. They contain no secrets.

# OS / editor
.DS_Store
*.swp

# paymaster: local high-water marks of decision logs (safety files, not evidence)
agent/runs/*.head
