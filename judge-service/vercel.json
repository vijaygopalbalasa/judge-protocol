{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "23 3 * * *"
    }
  ],
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "judge-protocol-api-mainnet.vercel.app"
        }
      ],
      "destination": "/mainnet.html",
      "permanent": false
    }
  ]
}
